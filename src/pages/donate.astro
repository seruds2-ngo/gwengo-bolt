---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Donate Now — GWE NGO INDIA"
  description="Donate to Glorious Women Empowerment NGO India. All donations are tax deductible under 80G Income Tax Exemption Act."
>
  <Header />
  <main id="main">
    <section class="page-hero">
      <div class="container">
        <h1>Donate Now</h1>
        <p>There's nothing more valuable than your support and love.</p>
      </div>
    </section>

    <section class="section">
      <div class="container donate-grid">
        <div>
          <h2>Your donation changes lives</h2>
          <p>
            All donations to Glorious Women Empowerment are tax deductible under 80G Income Tax
            Exemption Act. You will get a tax receipt and the purpose of donation utilization after
            we receive your donation, and you will receive feedback on the utilization of the amount
            for the specific purpose.
          </p>
          <ul class="donate-points">
            <li>₹500 — a nutritious meal kit for an elder</li>
            <li>₹2,500 — an education kit for a girl child</li>
            <li>₹10,000 — vocational skill training for a woman</li>
          </ul>
          <div class="payment-note">
            <h3>Other ways to give</h3>
            <p>
              For offline donations and CSR partnerships, please reach out to us directly.
            </p>
          </div>
        </div>

        <form class="donate-form">
          <h2 class="donate-form__title">Donate Now</h2>
          <div class="razorpay-button">
            <script src="https://checkout.razorpay.com/v1/payment-button.js" data-payment_button_id="pl_IyxvulburaaBAz" async></script>
          </div>
          <p class="donate-safe">Secure donation · 80G tax receipt provided</p>
        </form>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .donate-grid {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: var(--space-6);
    align-items: start;
  }

  .donate-points {
    padding-left: 1.2rem;
  }

  .donate-points li {
    margin-bottom: var(--space-1);
  }

  .payment-note {
    background: var(--color-primary-50);
    border-radius: var(--radius);
    padding: var(--space-3);
    margin-top: var(--space-3);
  }

  .donate-form {
    background: #fff;
    border-radius: var(--radius);
    box-shadow: var(--shadow-md);
    padding: var(--space-4);
  }

  .donate-form__title {
    color: var(--color-primary-600);
    margin-top: 0;
  }

  .razorpay-button {
    display: flex;
    justify-content: center;
    padding: var(--space-2) 0;
  }

  .donate-safe {
    text-align: center;
    font-size: 0.85rem;
    color: var(--neutral-700);
    margin: var(--space-2) 0 0;
  }

  @media (max-width: 900px) {
    .donate-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
