---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { IMAGES } from '../data/site';

const values = [
  {
    title: 'Empowerment',
    text: 'Providing opportunities to women to acquire education and skills and to overcome the obstacles they face in their family and community.',
  },
  {
    title: 'Focus',
    text: 'We focus mainly on women and children but do activities to other vulnerable, deprived sections and poor who are in need of support.',
  },
  {
    title: 'Dedication',
    text: 'We have service minded EC Members, dedicated staff and committed volunteers to take up upliftment activities for the needy.',
  },
  {
    title: 'Approach',
    text: 'We address educational, environmental and economic welfare of the women, children and other vulnerable sections of the society.',
  },
];

const causes = [
  {
    title: 'Support for Women',
    text: 'We need your support in creating awareness & implementation of Medical Health, Adult education, primary education and vocational skills for Women.',
    img: IMAGES.woman,
    href: '/women',
  },
  {
    title: 'Support for Girl Child',
    text: 'We need your support in organizing and conducting sensitization camps on sanitation, personal hygiene, health, education….',
    img: IMAGES.kids,
    href: '/children',
  },
  {
    title: 'Support for Elders',
    text: 'We need your support in providing welfare of senior citizens and elderly people with regards to Medical Health, Old Age homes and personal hygiene.',
    img: IMAGES.eldersHome,
    href: '/elders',
  },
];

const testimonials = [
  {
    quote:
      '"..... I felt proud to be associated with a noble cause of helping needy destitute elderly people of our country India. Of course I know that my contribution is significantly very small. However, I am very happy at least I could do this much with god\'s blessings. May god inspire every able citizen to come forward to contribute financially to this genuine GWE organization.',
    name: 'Gangopadhyaya Chatterjee',
    role: 'WASHINGTON D.C., USA',
  },
  {
    quote:
      '"though my financial contribution is very little compared to the amount of work being done, but I am very glad and to some extent quiet content that I am trying to fulfill my dream, which has been with me since I started my college. I am very much grateful to GWE for giving me opportunity to contribute for the needy beneficiaries. I am proud being an Indian and more importantly a proud human being."',
    name: 'Shwetha Roy',
    role: 'SOFTWARE ENGINEER, UNITED KINGDOM',
  },
];
---

<Layout>
  <Header />

  <main id="main">
    <section
      class="hero"
      style={`--hero-bg: url('${IMAGES.heroSlide1}')`}
    >
      <div class="container hero__inner">
        <div class="hero__content">
          <p class="eyebrow eyebrow--light">Glorious Women Empowerment — Since 1998</p>
          <h1 class="hero__title">
            There's Nothing<br />more valuable than<br /><span class="hero__title-accent">your support &amp; love.</span>
          </h1>
          <p class="hero__lead">
            In the year 1998, we, seven women, having passion in social service formed an
            organization by name "Glorious Women Empowerment".
          </p>
          <div class="hero__actions">
            <a class="btn btn--secondary" href="/donate">Donate Now</a>
            <a class="btn btn--ghost" href="/about-us/our-work">Read More</a>
          </div>
        </div>
        <aside class="hero__qr" aria-label="Donate via UPI QR code">
          <div class="hero__qr-tag">
            <strong>A little kindness. A better life.</strong>
            <span>Your support creates a lasting impact.</span>
          </div>
          <div class="hero__qr-card">
            <p class="hero__qr-label">Support Glorious Women Empowerment</p>
            <img
              src={IMAGES.qr}
              alt="UPI QR code to donate to Glorious Women Empowerment"
              width="240"
              height="240"
            />
            <p class="hero__qr-name">GLORIOUS WOMEN EMPOWERMENT</p>
          </div>
        </aside>
      </div>
    </section>

    <section class="section section--alt">
      <div class="container about-intro">
        <div class="about-intro__text">
          <p class="eyebrow">About GWE NGO India</p>
          <h2>
            In the year 1998, we, seven women, having passion in social service formed an
            organization by name "Glorious Women Empowerment".
          </h2>
          <p>
            We are all women members and belong to backward and downtrodden communities. Our society
            was registered and started activities for the upliftment of the quality of life of the
            downtrodden communities particularly women and children.
          </p>
          <p>
            We focus women and children but do activities to other vulnerable, disadvantaged,
            deprived sections, who are poor and in need of help and assistance.
          </p>
          <a class="btn btn--outline" href="/about-us">See More About Us</a>
        </div>
        <div class="about-intro__media">
          <img src={IMAGES.about} alt="About Glorious Women Empowerment" loading="lazy" />
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <p class="eyebrow">Our Values</p>
        <h2>What makes us different?</h2>
        <div class="grid values-grid">
          {
            values.map((v) => (
              <div class="value-card">
                <h3>{v.title}</h3>
                <p>{v.text}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section section--alt">
      <div class="container">
        <p class="eyebrow">Support for Women</p>
        <h2>Support for Women</h2>
        <div class="grid causes-grid">
          {
            causes.map((c) => (
              <a href={c.href} class="card cause-card">
                <img src={c.img} alt={c.title} loading="lazy" />
                <div class="card__body">
                  <h3>{c.title}</h3>
                  <p>{c.text}</p>
                  <span class="cause-card__link">Learn more →</span>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <p class="eyebrow">From Our Community</p>
        <h2>Donor Speak</h2>
        <div class="grid">
          {
            testimonials.map((t) => (
              <figure class="testimonial">
                <blockquote>{t.quote}</blockquote>
                <figcaption>
                  <strong>{t.name}</strong>
                  <span>{t.role}</span>
                </figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </section>

    <section class="cta-band">
      <div class="container cta-band__inner">
        <h2>Be the change — support women, children and elders today.</h2>
        <a class="btn btn--secondary" href="/donate">Donate Now</a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .hero {
    position: relative;
    background-image: var(--hero-bg);
    background-size: cover;
    background-position: center;
    color: #fff;
    padding: calc(var(--space-8) * 1.6) 0;
  }

  .hero__inner {
    position: relative;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .hero__content {
    flex: 1 1 480px;
  }

  .hero__qr {
    flex: 0 1 300px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .hero__qr-tag {
    background: #14532d;
    color: #fff;
    border-radius: var(--radius);
    padding: 16px 18px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .hero__qr-tag strong {
    font-size: 1.05rem;
    line-height: 1.3;
  }

  .hero__qr-tag span {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.85);
  }

  .hero__qr-card {
    background: #fff;
    color: var(--neutral-900);
    border-radius: var(--radius);
    padding: 16px;
    text-align: center;
    box-shadow: var(--shadow-md);
  }

  .hero__qr-label {
    margin: 0 0 12px;
    font-size: 0.8rem;
    font-weight: 700;
  }

  .hero__qr-card img {
    margin: 0 auto 12px;
    width: 240px;
    height: 240px;
  }

  .hero__qr-name {
    margin: 0;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--neutral-700);
  }

  .eyebrow--light {
    color: rgba(255, 255, 255, 0.85);
  }

  .hero h1,
  .hero__title {
    color: #fff;
    font-size: clamp(2.2rem, 4.5vw, 3.4rem);
    text-transform: none;
    text-shadow:
      0 1px 0 rgba(0, 0, 0, 0.35),
      0 2px 0 rgba(0, 0, 0, 0.3),
      0 3px 0 rgba(0, 0, 0, 0.25),
      0 6px 14px rgba(0, 0, 0, 0.45);
    letter-spacing: 0.01em;
  }

  .hero__title-accent {
    color: #f5b301;
  }

  .hero__lead {
    font-size: 1.15rem;
    color: rgba(255, 255, 255, 0.92);
    max-width: 540px;
  }

  .hero__actions {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
    margin-top: var(--space-3);
  }

  .about-intro {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: var(--space-4);
    align-items: center;
  }

  .about-intro__media img {
    border-radius: var(--radius);
    box-shadow: var(--shadow-md);
  }

  .values-grid {
    margin-top: var(--space-3);
  }

  .value-card {
    background: var(--color-primary-50);
    border-radius: var(--radius);
    padding: var(--space-3);
    border-left: 4px solid var(--color-primary-500);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .value-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }

  .value-card h3 {
    color: var(--color-primary-700);
  }

  .causes-grid {
    margin-top: var(--space-3);
  }

  .cause-card {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .cause-card__link {
    color: var(--color-primary-600);
    font-weight: 600;
  }

  .testimonial {
    margin: 0;
    background: #fff;
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    padding: var(--space-3);
    border-top: 4px solid var(--color-secondary-500);
  }

  .testimonial blockquote {
    margin: 0 0 var(--space-2);
    font-style: italic;
    color: var(--neutral-700);
  }

  .testimonial figcaption strong {
    display: block;
    color: var(--neutral-900);
  }

  .testimonial figcaption span {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-primary-600);
  }

  .cta-band {
    background: linear-gradient(135deg, var(--color-secondary-600), var(--color-secondary-500));
    color: #fff;
    padding: var(--space-6) 0;
  }

  .cta-band__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .cta-band h2 {
    color: #fff;
    margin: 0;
  }

  @media (max-width: 900px) {
    .about-intro {
      grid-template-columns: 1fr;
    }
  }
</style>
