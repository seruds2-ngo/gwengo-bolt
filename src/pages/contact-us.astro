---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Contact Us — GWE NGO INDIA"
  description="Contact Glorious Women Empowerment NGO, Kurnool, Andhra Pradesh, India."
>
  <Header />
  <main id="main">
    <section class="page-hero">
      <div class="container">
        <h1>Contact Us</h1>
        <p>Want to reach out? We'd love to hear from you!</p>
      </div>
    </section>
    <section class="section">
      <div class="container contact-grid">
        <div class="contact-info">
          <h2>GLORIOUS WOMEN EMPOWERMENT</h2>
          <p>
            D.No.48-53, Budhawarapeta,<br />
            Near Chenna Keshavaswamy Temple, Kurnool-518002<br />
            Andhra Pradesh, INDIA.
          </p>
          <p><strong>Location</strong> — Kurnool, Andhra Pradesh</p>
          <p>
            <strong>Phone</strong> — <a href="tel:+917665119171">+91 76651 19171</a>
          </p>
          <p>
            <strong>E-mail</strong> —
            <a href="mailto:mail2gwe@gmail.com">mail2gwe@gmail.com</a>
          </p>
          <div class="socials">
            <h3>Follow Us</h3>
            <ul>
              <li><a href="https://www.facebook.com/GloriousWomenEmpowerment" target="_blank" rel="noopener">Facebook</a></li>
              <li><a href="https://twitter.com/gwengoindia" target="_blank" rel="noopener">Twitter</a></li>
              <li><a href="https://www.youtube.com/channel/UCZvFzTGWBa9fMT0xAvu08lA" target="_blank" rel="noopener">Youtube</a></li>
              <li><a href="https://www.linkedin.com/" target="_blank" rel="noopener">Linkedin</a></li>
            </ul>
          </div>
        </div>

        <iframe
          title="GWE NGO India location — Kurnool, Andhra Pradesh"
          class="contact-map"
          src="https://www.google.com/maps?q=Chenna%20Keshavaswamy%20Temple,%20Kurnool,%20Andhra%20Pradesh%20518002&output=embed"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>

        <form
          class="contact-form"
          onsubmit="event.preventDefault(); this.reset(); alert('Thank you for reaching out! We will get back to you soon.');"
        >
          <h3>Drop Us a Line</h3>
          <div class="form-row">
            <div class="form-field">
              <label for="cf-first">Name <span aria-hidden="true">*</span></label>
              <input id="cf-first" name="firstName" type="text" required />
              <small>First</small>
            </div>
            <div class="form-field">
              <label for="cf-last" class="sr-only">Last Name</label>
              <input id="cf-last" name="lastName" type="text" required />
              <small>Last</small>
            </div>
          </div>
          <div class="form-field">
            <label for="cf-email">Email <span aria-hidden="true">*</span></label>
            <input id="cf-email" name="email" type="email" required />
          </div>
          <div class="form-field">
            <label for="cf-message">Comment or Message</label>
            <textarea id="cf-message" name="message" rows="6"></textarea>
          </div>
          <button class="btn btn--primary" type="submit">Submit</button>
        </form>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: var(--space-6);
    align-items: start;
  }

  .contact-map {
    width: 100%;
    min-height: 320px;
    border: 0;
    border-radius: var(--radius);
    box-shadow: var(--shadow-md);
  }

  .contact-form {
    background: #fff;
    border-radius: var(--radius);
    box-shadow: var(--shadow-md);
    padding: var(--space-4);
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2);
  }

  .form-field {
    display: flex;
    flex-direction: column;
    margin-bottom: var(--space-2);
  }

  .form-field label {
    font-weight: 600;
    font-size: 0.9rem;
    margin-bottom: 6px;
  }

  .form-field input,
  .form-field textarea {
    padding: 12px 14px;
    border: 1px solid var(--neutral-200);
    border-radius: 8px;
    font-size: 1rem;
    font-family: inherit;
    transition: border-color 0.2s ease;
  }

  .form-field textarea {
    resize: vertical;
  }

  .form-field input:focus,
  .form-field textarea:focus {
    outline: none;
    border-color: var(--color-primary-500);
  }

  .form-field small {
    color: var(--neutral-700);
    margin-top: 4px;
  }

  .socials ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
