---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Contact Us — GWE NGO INDIA"
  description="Contact Glorious Women Empowerment NGO, Kurnool, Andhra Pradesh, India."
>
  <Header />
  <main id="main">
    <section class="page-hero">
      <div class="container">
        <h1>Contact Us</h1>
        <p>Want to reach out? We'd love to hear from you!</p>
      </div>
    </section>
    <section class="section">
      <div class="container contact-grid">
        <div class="contact-info">
          <h2>GLORIOUS WOMEN EMPOWERMENT</h2>
          <p>
            D.No.48-53, Budhawarapeta,<br />
            Near Chenna Keshavaswamy Temple, Kurnool-518002<br />
            Andhra Pradesh, INDIA.
          </p>
          <p><strong>Location</strong> — Kurnool, Andhra Pradesh</p>
          <p>
            <strong>Phone</strong> — <a href="tel:+917665119171">+91 76651 19171</a>
          </p>
          <p>
            <strong>E-mail</strong> —
            <a href="mailto:mail2gwe@gmail.com">mail2gwe@gmail.com</a>
          </p>
          <div class="socials">
            <h3>Follow Us</h3>
            <ul>
              <li>
                <a href="https://www.facebook.com/GloriousWomenEmpowerment" target="_blank" rel="noopener" aria-label="Facebook">
                  <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5 3.66 9.15 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.51 1.49-3.9 3.78-3.9 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.88h2.78l-.44 2.91h-2.34V22c4.78-.79 8.43-4.94 8.43-9.94Z"/></svg>
                </a>
              </li>
              <li>
                <a href="https://twitter.com/gwengoindia" target="_blank" rel="noopener" aria-label="Twitter">
                  <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M18.9 2H22l-7.5 8.6L23 22h-6.9l-5.4-7-6.2 7H1.4l8-9.2L1 2h7l4.9 6.5L18.9 2Zm-1.2 18h1.9L7.4 4H5.4l12.3 16Z"/></svg>
                </a>
              </li>
              <li>
                <a href="https://www.youtube.com/channel/UCZvFzTGWBa9fMT0xAvu08lA" target="_blank" rel="noopener" aria-label="YouTube">
                  <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M23 12s0-3.2-.4-4.7c-.2-.9-.9-1.6-1.8-1.8C19.3 5 12 5 12 5s-7.3 0-8.8.5c-.9.2-1.6.9-1.8 1.8C1 8.8 1 12 1 12s0 3.2.4 4.7c.2.9.9 1.6 1.8 1.8 1.5.5 8.8.5 8.8.5s7.3 0 8.8-.5c.9-.2 1.6-.9 1.8-1.8.4-1.5.4-4.7.4-4.7Zm-13 3V9l5.2 3-5.2 3Z"/></svg>
                </a>
              </li>
              <li>
                <a href="https://www.linkedin.com/" target="_blank" rel="noopener" aria-label="LinkedIn">
                  <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M20.4 3H3.6C3.3 3 3 3.3 3 3.6v16.8c0 .3.3.6.6.6h16.8c.3 0 .6-.3.6-.6V3.6c0-.3-.3-.6-.6-.6ZM8.3 18.3H5.7V9.7h2.6v8.6ZM7 8.5a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3Zm11.3 9.8h-2.6v-4.2c0-1 0-2.3-1.4-2.3s-1.6 1.1-1.6 2.2v4.3h-2.6V9.7h2.5v1.2h.1c.4-.7 1.3-1.4 2.6-1.4 2.8 0 3.3 1.8 3.3 4.2v4.6Z"/></svg>
                </a>
              </li>
            </ul>
          </div>
        </div>

        <form
          class="contact-form"
          onsubmit="event.preventDefault(); this.reset(); alert('Thank you for reaching out! We will get back to you soon.');"
        >
          <h3>Drop Us a Line</h3>
          <div class="form-row">
            <div class="form-field">
              <label for="cf-first">Name <span aria-hidden="true">*</span></label>
              <input id="cf-first" name="firstName" type="text" required />
              <small>First</small>
            </div>
            <div class="form-field">
              <label for="cf-last" class="sr-only">Last Name</label>
              <input id="cf-last" name="lastName" type="text" required />
              <small>Last</small>
            </div>
          </div>
          <div class="form-field">
            <label for="cf-email">Email <span aria-hidden="true">*</span></label>
            <input id="cf-email" name="email" type="email" required />
          </div>
          <div class="form-field">
            <label for="cf-message">Comment or Message</label>
            <textarea id="cf-message" name="message" rows="6"></textarea>
          </div>
          <button class="btn btn--primary" type="submit">Submit</button>
        </form>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
    align-items: start;
  }

  .contact-form {
    background: #fff;
    border-radius: var(--radius);
    box-shadow: var(--shadow-md);
    padding: var(--space-4);
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2);
  }

  .form-field {
    display: flex;
    flex-direction: column;
    margin-bottom: var(--space-2);
  }

  .form-field label {
    font-weight: 600;
    font-size: 0.9rem;
    margin-bottom: 6px;
  }

  .form-field input,
  .form-field textarea {
    padding: 12px 14px;
    border: 1px solid var(--neutral-200);
    border-radius: 8px;
    font-size: 1rem;
    font-family: inherit;
    transition: border-color 0.2s ease;
  }

  .form-field textarea {
    resize: vertical;
  }

  .form-field input:focus,
  .form-field textarea:focus {
    outline: none;
    border-color: var(--color-primary-500);
  }

  .form-field small {
    color: var(--neutral-700);
    margin-top: 4px;
  }

  .socials ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .socials a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    color: #fff;
    background: var(--color-primary-600, #1f6f8b);
    transition:
      transform 0.2s ease,
      background-color 0.2s ease;
  }

  .socials a:hover {
    transform: translateY(-3px);
    background: var(--color-primary-700, #15536b);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
