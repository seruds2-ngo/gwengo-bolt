---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RazorpayDonate from '../../components/RazorpayDonate.astro';
---

<Layout
  title="Day Care — GWE NGO INDIA"
  description="Day care for poor children from working families who do not get the care they deserve."
>
  <Header />
  <main id="main">
    <section class="page-hero">
      <div class="container">
        <h1>Day Care</h1>
        <p>Care for the little ones whose parents work hard to make ends meet.</p>
      </div>
    </section>
    <section class="section">
      <div class="container prose">
        <img class="page-image" src="/images/day-care.webp" alt="Children at GWE NGO India day care" loading="lazy" />
        <p>
          Day Care is provided for poor children from working families who do not get the care they
          deserve. These programs have been designed to help these sweet little children grow and
          reach the heights of success — with a safe place to stay, learn and play while their
          parents are at work.
        </p>
        <RazorpayDonate />
      </div>
    </section>
  </main>
  <Footer />
</Layout>
