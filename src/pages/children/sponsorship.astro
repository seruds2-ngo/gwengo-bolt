---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Layout
  title="Sponsorship for Children — GWE NGO INDIA"
  description="Sponsor a child's education and help them build a better career and future."
>
  <Header />
  <main id="main">
    <section class="page-hero">
      <div class="container">
        <h1>Sponsorship for Children</h1>
        <p>Help a child study and get a better career.</p>
      </div>
    </section>
    <section class="section">
      <div class="container prose">
        <p>
          Sponsorship for children helps them study without interruption and get a better career.
          Your sponsorship covers their educational needs and gives them the chance to grow and
          reach the heights of success.
        </p>
        <p>
          When you sponsor a child through GWE NGO India, you receive feedback on the utilization of
          your contribution for the specific purpose of the child's education.
        </p>
        <a class="btn btn--primary" href="/donate">Sponsor a Child</a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
