---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Layout title="Our Vision — GWE NGO INDIA">
  <Header />
  <main id="main">
    <section class="page-hero">
      <div class="container">
        <h1>Our Vision</h1>
        <p>Glorious Women Empowerment — a society where every woman, child and elder lives with dignity.</p>
      </div>
    </section>
    <section class="section">
      <div class="container prose">
        <p>
          Our vision is a society in which women are empowered to lead, children are educated and
          protected, and elders are cared for with love and respect. We envision the fruits of
          development reaching the downtrodden communities, so that no one is left behind because of
          poverty, caste or lack of awareness.
        </p>
        <p>
          We work towards the social, economic, health, educational, agricultural, rural development
          and cultural transformation of society — starting with women and children in Kurnool and
          Kadapa Districts of Andhra Pradesh, and expanding to Ananthapur and Chittoor in the coming
          years.
        </p>
        <a class="btn btn--primary" href="/donate">Support Our Vision</a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
