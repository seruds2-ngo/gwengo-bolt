---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Layout title="Our Mission — GWE NGO INDIA">
  <Header />
  <main id="main">
    <section class="page-hero">
      <div class="container">
        <h1>Our Mission</h1>
        <p>Uplifting the quality of life of the downtrodden — particularly women and children.</p>
      </div>
    </section>
    <section class="section">
      <div class="container prose">
        <p>
          Our mission is to take up social, economic, health, educational, agricultural, rural
          development and cultural activities for the transformation of society, with a focus on
          women and children belonging to backward and downtrodden communities.
        </p>
        <ul>
          <li>Provide opportunities for women to acquire education, skills and independence.</li>
          <li>Support children with education material, sponsorship, uniforms and day care.</li>
          <li>Provide welfare for senior citizens with regard to medical health, old age homes and personal hygiene.</li>
          <li>Conduct sensitization camps on sanitation, personal hygiene, health and education.</li>
        </ul>
        <a class="btn btn--primary" href="/donate">Support Our Mission</a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
