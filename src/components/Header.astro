---
import { NAV, IMAGES, SITE } from '../data/site';
import { AstroCurrentPath } from '../lib/paths';

const path = AstroCurrentPath(Astro.url.pathname);
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label={`${SITE.name} home`}>
      <img src={IMAGES.logo} alt={`${SITE.name} logo`} width="200" height="64" />
    </a>

    <nav class="nav" id="site-nav" data-nav aria-label="Main navigation">
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={[
                  'nav__link',
                  { 'nav__link--active': item.href === path },
                  { 'nav__link--cta': item.cta },
                ]}
                aria-current={item.href === path ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

      <button class="menu-toggle" id="menu-toggle" data-menu-toggle aria-expanded="false" aria-controls="site-nav">
      <span class="menu-toggle__bar"></span>
      <span class="menu-toggle__bar"></span>
      <span class="menu-toggle__bar"></span>
      <span class="sr-only">Menu</span>
    </button>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: #fff;
    box-shadow: var(--shadow-sm);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    min-height: 72px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: var(--neutral-900);
  }

  .brand img {
    height: 64px;
    width: auto;
  }

  .nav ul {
    display: flex;
    align-items: center;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav__link {
    display: inline-block;
    padding: 10px 14px;
    border-radius: 8px;
    text-decoration: none;
    color: var(--neutral-800);
    font-weight: 500;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .nav__link:hover {
    background: var(--color-primary-50);
    color: var(--color-primary-700);
  }

  .nav__link--active {
    color: var(--color-primary-700);
    font-weight: 700;
  }

  .nav__link--cta {
    background: var(--color-secondary-500);
    color: #fff;
    font-weight: 700;
  }

  .nav__link--cta:hover {
    background: var(--color-secondary-600);
    color: #fff;
  }

  .menu-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    padding: 8px;
    cursor: pointer;
  }

  .menu-toggle__bar {
    width: 24px;
    height: 3px;
    background: var(--neutral-900);
    border-radius: 2px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  @media (max-width: 860px) {
    .menu-toggle {
      display: flex;
    }

    .nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: #fff;
      box-shadow: var(--shadow-md);
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.3s ease;
    }

    .nav.is-open {
      max-height: 400px;
    }

    .nav ul {
      flex-direction: column;
      align-items: stretch;
      padding: var(--space-2);
      gap: 2px;
    }

    .nav__link {
      display: block;
      padding: 14px 16px;
    }
  }
</style>
